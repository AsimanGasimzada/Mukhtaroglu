@using Mukhtaroglu.Business.Services.Abstractions
@inject ContactLocalizer _localizer
@inject IUIService _service
@{
    var settings = await _service.GetSettingsAsync();
}

<!-- Section: CTA Form -->
<section class="backlight-top is-fullwidth">
    <div class="stg-row stg-valign-middle stg-cta-with-image stg-tp-column-reverse">
        <div class="stg-col-5" data-unload="fade-left">
            <div class="bringer-offset-image" data-bg-src="~/img/test.jpg" data-appear="fade-up" data-threshold="0.25"></div>
            <form asp-action="SendRequest" asp-controller="Contact" method="post" class="bringer-contact-form bringer-block" data-fill-error="Please, fill out the contact form." data-appear="fade-right" data-threshold="0.25">
                <div class="bringer-form-content">
                    <!-- Field: Name -->
                    <label for="name">@_localizer.GetValue("YourName")</label>
                    <input type="text" id="name" name="name" placeholder="@_localizer.GetValue("YourName")" required>
                    <!-- Field: Email -->
                    <label for="email">@_localizer.GetValue("YourEmail")</label>
                    <input type="email" id="email" name="email" placeholder="email@example.com" required>
                    <!-- Field: Message -->
                    <label for="message">@_localizer.GetValue("YourMessage")</label>
                    <textarea id="message" name="message" placeholder="@_localizer.GetValue("YourMessage")" required></textarea>
                    <!-- Form Button -->
                    <button type="submit" value="Send Message">@_localizer.GetValue("Send")</button>
                    <div class="bringer-contact-form__response"></div>
                </div>
                <span class="bringer-form-spinner"></span>
            </form>
        </div>
        <div class="stg-col-6 stg-offset-1" data-unload="fade-right">
            <div class="bringer-cta-form-content">
                <div class="bringer-cta-form-title" data-split-appear="fade-up" data-split-delay="100" data-split-by="line">
                    @Model.Settings["ContactFormTitle"]
                </div>
                <div class="bringer-cta-text">
                    <div class="stg-row stg-valign-middle">
                        <div class="stg-col-2 stg-offset-2 stg-tp-col-1 stg-tp-offset-3 stg-m-col-1 stg-m-offset-2" data-appear="fade-right">
                            <i class="bringer-cta-icon"></i>
                        </div>
                        <div class="stg-col-8 stg-tp-col-7 stg-m-col-8 stg-m-offset-1" data-appear="fade-left">
                            <p class="bringer-large-text">@Model.Settings["ContactFormDescription"]</p>
                        </div>
                    </div>
                </div>
                <div class="bringer-cta-counters bringer-grid-3cols bringer-m-grid-3cols" data-stagger-appear="fade-up" data-stagger-delay="100">
                    <!-- Counter Item -->
                    <div class="bringer-counter bringer-small-counter" data-delay="3000">
                        <div class="bringer-counter-number" data-suffix="+">@settings["ProductCount"]</div>
                        <div class="bringer-counter-label">@_localizer.GetValue("ProductCount")</div>
                    </div><!-- .bringer-counter -->
                    <!-- Counter Item -->
                    <div class="bringer-counter bringer-small-counter" data-delay="3000">
                        <div class="bringer-counter-number" data-suffix="+">@settings["CustomerCount"]</div>
                        <div class="bringer-counter-label">@_localizer.GetValue("ClientCount")</div>
                    </div><!-- .bringer-counter -->
                    <!-- Counter Item -->
                    <div class="bringer-counter bringer-small-counter" data-delay="3000">
                        <div class="bringer-counter-number" data-suffix="">@settings["MagazineCount"]</div>
                        <div class="bringer-counter-label">@_localizer.GetValue("Experience")</div>
                    </div><!-- .bringer-counter -->
                </div>
            </div>
        </div>
    </div>
</section>