@model HomeDto
@inject HomeLocalizer _localizer

<style>
    .slider-item {
        position: relative;
    }

    .slider-img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* Overlay content */
    .slider-content {
        position: absolute;
        top: 50%;
        left: 10%;
        transform: translateY(-50%);
        color: white;
        background-color: rgba(0, 0, 0, 0.5);
        padding: 20px;
        border-radius: 10px;
        max-width: 40%;
    }

        .slider-content h2 {
            margin: 0 0 10px 0;
            font-size: 2rem;
        }

        .slider-content p {
            margin: 0;
            font-size: 1.2rem;
        }

    .slider-btn {
        display: inline-block;
        margin-top: 15px;
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-size: 1rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .slider-content {
            left: 5%;
            top: 80%;
            transform: translateY(-80%);
            max-width: 90%;
            padding: 15px;
        }

            .slider-content h2 {
                font-size: 1.5rem;
            }

            .slider-content p {
                font-size: 1rem;
            }

        .slider-btn {
            font-size: 0.9rem;
            padding: 8px 16px;
        }
    }

    @@media (max-width: 480px) {
        .slider-content {
            top: auto;
            bottom: 10%;
            transform: none;
            max-width: 90%;
            padding: 10px;
        }

            .slider-content h2 {
                font-size: 1.2rem;
            }

            .slider-content p {
                font-size: 0.9rem;
            }

        .slider-btn {
            font-size: 0.8rem;
            padding: 6px 12px;
        }
    }
</style>




<!-- Hero Section -->
<section data-padding="top">
    <div class="bringer-hero-block bringer-hero-type01">
        <!-- Main Line -->
        <div class="stg-row stg-bottom-gap-l stg-m-bottom-gap-l">
            <div class="stg-col-9 stg-tp-col-8 stg-m-col-12">
                <!-- Title -->
                <h1 class="bringer-page-title" data-split-appear="fade-up" data-split-unload="fade-up">@Model.Settings["HomeSection1Title"]</h1>
            </div>
        </div><!-- .stg-row -->

    </div><!-- .bringer-hero-block -->
    <div class="bringer-hero-block bringer-hero-type04" data-unload="fade-up">
        <!-- Media Slider -->
        <div class="bringer-hero-media-wrap bringer-masked-block stg-bottom-gap stg-m-bottom-gap-s" data-appear="zoom-out">
            <div class="swiper bringer-slider bringer-masked-media" data-autoplay="3000" data-duration="1000" data-effect="coverflow">
                <div class="swiper-wrapper">
                    @foreach (var slider in Model.Sliders)
                    {
                        <div class="swiper-slide slider-item">
                            <img src="@slider.ImagePath" alt="@slider.Title" class="slider-img">

                            @if (!string.IsNullOrWhiteSpace(slider.Title))
                            {
                                <div class="slider-content">
                                    <h2>@slider.Title</h2>
                                    <p>@slider.Description</p>
                                    <a href="@slider.Url" class="slider-btn">
                                        @slider.ButtonTitle
                                    </a>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div><!-- .bringer-slider -->
            <!-- Masked Navigation -->
            <div class="bringer-slider-nav bringer-masked-content at-bottom-right">
                <a href="#" class="bringer-slider-prev">
                    <span class="bringer-icon bringer-icon-chevron-left"></span>
                </a>
                <a href="#" class="bringer-slider-next">
                    <span class="bringer-icon bringer-icon-chevron-right"></span>
                </a>
            </div>
        </div><!-- .bringer-hero-media-wrap -->
        <!-- Info Line -->
        @* <div class="bringer-hero-info-line"> *@
        @*     <div data-appear="fade-up" data-delay="50">8 awards won</div> *@
        @*     <div data-appear="fade-up" data-delay="150">From 2020</div> *@
        @*     <div data-appear="fade-up" data-delay="250">420 portfolio Done</div> *@
        @* </div><!-- .bringer-hero-info-line --> *@
        <!-- Title -->
        @*   <div class="align-center">
            <div class="stg-bottom-gap">
                <h1 class="bringer-page-title is-large" data-appear="fade-up" data-delay="100" data-threshold="0">We are Bringer</h1>
            </div>
            <p class="bringer-large-text" data-appear="fade-up" data-delay="200" data-threshold="0">We help creative agencies, designers, and other creative people showcase their work and connect with clients.</p>
        </div> *@
    </div><!-- .bringer-hero-block -->
</section>




<!-- Section: Counters -->
<section data-padding="bottom">
    <div class="bringer-grid-4cols bringer-tp-grid-2cols bringer-m-grid-2cols stg-m-small-gap" data-stagger-appear="zoom-in" data-stagger-unload="zoom-out">
        <!-- Counter Item -->
        <div class="bringer-counter bringer-block" data-delay="4000">
            <div class="bringer-counter-number" data-suffix="+">@Model.Settings["CustomerCount"]</div>
            <div class="bringer-counter-label">@_localizer.GetValue("HappyCustomers")</div>
        </div><!-- .bringer-counter -->
        <!-- Counter Item -->
        <div class="bringer-counter bringer-block" data-delay="4000">
            <div class="bringer-counter-number" data-suffix="+">@Model.Settings["ProductCount"]</div>
            <div class="bringer-counter-label">@_localizer.GetValue("CompletedProjects")</div>
        </div><!-- .bringer-counter -->
        <!-- Counter Item -->
        <div class="bringer-counter bringer-block" data-delay="4000">
             <div class="bringer-counter-number" data-suffix="+">@Model.Settings["MagazineCount"]</div>
            <div class="bringer-counter-label">@_localizer.GetValue("CertificateCount")</div>
         
        </div><!-- .bringer-counter -->
        <!-- Counter Item -->
        <div class="bringer-counter bringer-block is-accented" data-delay="4000">
              <div class="bringer-counter-number" data-suffix="+">@Model.Settings["CerificateCount"]</div>
            <div class="bringer-counter-label">@_localizer.GetValue("StoresCount")</div>
        </div><!-- .bringer-counter -->
    </div><!-- .bringer-grid -->
</section>

<!-- Section: Services -->
<section>
    <!-- Section Title -->
    <div class="stg-row bringer-section-title">
        <div class="stg-col-8 stg-offset-2">
            <div class="align-center">
                <h2 data-appear="fade-up" data-unload="fade-up">@Model.Settings["HomeSection2Title"]</h2>
                <p class="bringer-large-text is-short" data-appear="fade-up" data-unload="fade-up" data-delay="100">@Model.Settings["HomeSection2Description"]</p>
            </div>
        </div>
    </div>
    <!-- Section Content -->
    <div class="stg-row stg-valign-middle stg-large-gap">
        <div class="stg-col-5 bringer-tp-grid-2cols bringer-m-grid-1col">

            @foreach (var service in Model.Services.Take(Model.Services.Count / 2))
            {
                <!-- Icon Box -->
                <div class="bringer-image-box" data-appear="fade-right" data-unload="fade-left">
                    <div class="bringer-image-box-head" style="gap:30px">
                        <img src="@service.ImagePath" alt="@service.Name">
                        <h5>@service.Name<span class="bringer-accent">.</span></h5>
                    </div>
                    <div class="bringer-image-box-content">
                        <p>@service.Description</p>
                    </div>
                </div>

                <!-- .bringer-image-box -->
            }

        </div>
        @*    <div class="stg-col-4 stg-tp-col-8 stg-tp-offset-2 stg-tp-bottom-gap-l" data-appear="zoom-out" data-unload="zoom-out" data-delay="150">
            <div class="bringer-parallax-media">
                <img class="bringer-lazy" src="img/null.png" data-src="img/home/services.jpg" alt="Our Services" width="800" height="1200">
            </div>
        </div> *@

        <div class="stg-col-5 bringer-tp-grid-2cols bringer-m-grid-1col">
            @foreach (var service in Model.Services.OrderByDescending(x => x.Id).Take(Model.Services.Count / 2))
            {
                <!-- Icon Box -->
                <div class="bringer-image-box" data-appear="fade-right" data-unload="fade-left">
                    <div class="bringer-image-box-head" style="gap:30px">
                        <img src="@service.ImagePath" alt="@service.Name">
                        <h5>@service.Name<span class="bringer-accent">.</span></h5>
                    </div>
                    <div class="bringer-image-box-content">
                        <p>@service.Description</p>
                    </div>
                </div>

                <!-- .bringer-image-box -->
            }
        </div>
    </div>
</section>





@if (Model.About is { } about)
{
    <!-- Section: About Us -->
    <section class="backlight-top">
        <div class="stg-row stg-large-gap stg-m-normal-gap">
            <div class="stg-col-6 stg-tp-bottom-gap-l stg-m-bottom-gap" data-unload="fade-left">
                <div class="bringer-parallax-media">
                    <img class="bringer-lazy" src="img/null.png" data-src="@about.ImagePath" alt="We are Bringer" width="960" height="960">
                </div>
            </div>
            <div class="stg-col-6 stg-vertical-space-between" data-unload="fade-right">
                <div>
                    <h3>@about.Title</h3>
                    <p class="bringer-large-text">@Html.Raw(about.Description)</p>
                </div>
                <a asp-action="Index" asp-controller="About" class="bringer-icon-link">
                    <div class="bringer-icon-wrap">
                        <i class="bringer-icon bringer-icon-explore"></i>
                    </div>
                    <div class="bringer-icon-link-content">
                        <h6>
                            @_localizer.GetValue("LearnMoreTitle")
                        </h6>
                        <span class="bringer-label">@_localizer.GetValue("LearnMore")</span>
                    </div>
                </a><!-- .bringer-icon-link -->
            </div>
        </div><!-- .stg-row -->
    </section>
}



<!-- Section: Portfolio Carousel -->
<section class="is-fullwidth is-stretched">
    <!-- Section Title -->
    <div class="stg-row bringer-section-title is-boxed">
        <div class="stg-col-8 stg-offset-2">
            <div class="align-center">
                <h2 data-appear="fade-up" data-unload="fade-up">@Model.Settings["HomeSection3Title"]</h2>
            </div>
        </div>
    </div>
    <!-- Portfolio Carousel -->
    <div class="swiper bringer-carousel stg-bottom-gap-l" data-appear="fade-up" data-unload="fade-up" data-delay="200" data-count="4" data-m-count="1.5">
        <div class="swiper-wrapper">
            @foreach (var product in Model.Products)
            {
                <div class="bringer-block bringer-portfolio-card swiper-slide">
                    <div class="bringer-portfolio-card-image">
                        <img class="bringer-lazy" src="@product.ImagePath" data-src="@product.ImagePath" alt="" width="1200" height="1200">
                    </div>
                    <div class="bringer-portfolio-card-footer">
                        <div class="bringer-portfolio-card-title">
                            <span class="bringer-meta">@product.Name</span>
                            <h6>@product.Category</h6>
                        </div>
                        <span class="bringer-icon bringer-icon-explore"></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(product.Url))
                    {
                        <a href="@product.Url"></a>
                    }
                </div>

                <!-- .bringer-portfolio-card -->
            }
        </div>
        <!-- Pagination -->
        <div class="swiper-pagination bringer-dots"></div>
    </div><!-- .bringer-portfolio-carousel -->
 
</section>

<!-- Section: Marquee -->
<section class="is-fullwidth is-stretched" data-padding="none">
    <div class="bringer-marquee" data-speed="2500">
        <div class="bringer-marquee-inner">
            <ul class="bringer-marquee-list">
                @foreach (var service in Model.Services)
                {
                    <li>
                        <h2>@service.Name</h2>
                    </li>
                }

            </ul>
        </div><!-- .bringer-marquee-inner -->
    </div><!-- .bringer-marquee -->
</section>



<!-- Section: Testimonials -->
<section class="backlight-top">
    @* <div class="bringer-expand-on-scroll"> *@
    @*     <img src="img/home/testimonials01.jpg" alt="Testimonials" data-unload="fade-up"> *@
    @* </div><!-- .bringer-expand-on-scroll --> *@
    <div class="stg-row stg-large-gap stg-top-gap-l">
        <div class="stg-col-6 stg-tp-bottom-gap-l" data-unload="fade-left">
            <div class="bringer-sticky-block">
                <h2>@Model.Settings["HomeSection4Title"]</h2>
                <p class="bringer-large-text">@Model.Settings["HomeSection4Description"]</p>
                @* <div class="align-right"> *@
                @*     <a href="testimonials.html" class="bringer-arrow-link">Read all Testimonials</a> *@
                @* </div> *@
            </div>
        </div>
        <div class="stg-col-6">
            <div class="bringer-grid-1col stg-normal-gap">
                @foreach (var recommendation in Model.Recommendations)
                {
                    <!-- Card Item -->
                    <div class="bringer-block bringer-tetimonials-card" data-appear="zoom-out" data-unload="fade-right" data-threshold="0.75">
                        <div class="bringer-tetimonials-card-descr">
                            "@recommendation.Title"
                        </div>
                        <div class="bringer-tetimonials-card-footer">
                            <div class="bringer-tetimonials-card-name">
                                <h6>@recommendation.Author</h6>
                                <span class="bringer-meta">@recommendation.Profession</span>
                            </div>
                            <div class="bringer-tetimonials-card-rate">
                                <span class="bringer-tetimonials-stars@(recommendation.Rating)"></span>
                            </div>
                        </div>
                    </div>

                    <!-- .bringer-tetimonials-card -->
                }

            </div><!-- .bringer-grid -->
        </div>
    </div><!-- .stg-row -->
</section>


<!-- Section: Team -->
<section>
    <!-- Section Title -->
    <div class="stg-row bringer-section-title">
        <div class="stg-col-8 stg-offset-2 stg-tp-col-10 stg-tp-offset-1">
            <div class="align-center" data-stagger-appear="fade-up" data-stagger-unload="fade-up" data-stagger-delay="100">
                <h2>@Model.Settings["HomeSection5Title"]</h2>
                <p class="bringer-large-text">@Model.Settings["HomeSection5Description"]</p>
            </div>
        </div>
    </div>
    <!-- Team Carousel -->
    <div class="swiper bringer-carousel" data-appear="fade-up" data-delay="200" data-tp-centered="0" data-unload="fade-up">
        <div class="swiper-wrapper">

            @foreach (var employee in Model.Employees)
            {
                <!-- Carousel Item -->
                <div class="bringer-block bringer-carousel-card swiper-slide">
                    <div class="bringer-carousel-card-image">
                        <img class="bringer-lazy" src="@employee.ImagePath" data-src="@employee.ImagePath" alt="@employee.Fullname" width="600" height="900">
                    </div>
                    <div class="bringer-carousel-card-footer">
                        <div class="bringer-carousel-card-title">
                            <span class="bringer-meta">@employee.Position</span>
                            <h6>@employee.Fullname</h6>
                        </div>
                        <span class="bringer-icon bringer-icon-explore"></span>
                    </div>
                    <a asp-action="Index" asp-controller="Team" asp-route-id="@employee.Id"></a>
                </div>

                <!-- .bringer-carousel-card -->
            }

        </div>
        <!-- Pagination -->
        <div class="swiper-pagination bringer-dots"></div>
    </div><!-- .bringer-carousel -->
</section>


<partial name="_contactPartial"></partial>