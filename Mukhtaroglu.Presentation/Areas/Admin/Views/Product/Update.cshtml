@model ProductUpdateDto

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <p class="card-description">
                Məhsul yarat
            </p>
            <form method="post" class="forms-sample" enctype="multipart/form-data">

                <div class="text-danger" asp-validation-summary="ModelOnly"></div>

                <div class="form-group">

                    <input asp-for="@Model.ProductLanguages[0].LanguageId" value="1" type="hidden" />
                    <div class="form-group">
                        <label for="exampleInputUsername1">Azərbaycanca ad</label>
                        <input class="form-control employeeName" required asp-for="@Model.ProductLanguages[0].Name" placeholder="Ad daxil edin">
                        <span asp-validation-for="@Model.ProductLanguages[0].Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="exampleInputUsername1">Azərbaycanca Kateqoriya</label>
                        <input class="form-control employeePosition" required asp-for="@Model.ProductLanguages[0].Category" placeholder="Vəzifə daxil edin">
                        <span asp-validation-for="@Model.ProductLanguages[0].Category" class="text-danger"></span>
                    </div>


                    <div class="form-group">
                        <input class=" sameDataInput" id="checkbox" type="checkbox">
                        <label for="checkbox">Bütün dillərdə eyni olsun</label>
                    </div>

                </div>

                <hr />
                <br />
                <br />

                <div class="form-group">

                    <input asp-for="@Model.ProductLanguages[1].LanguageId" value="2" type="hidden" />
                    <div class="form-group">
                        <label for="exampleInputUsername1">İngiliscə ad</label>
                        <input class="form-control employeeName" required asp-for="@Model.ProductLanguages[1].Name" placeholder="Ad daxil edin">
                        <span asp-validation-for="@Model.ProductLanguages[1].Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="exampleInputUsername1">İngiliscə kateqoriya</label>
                        <input class="form-control employeePosition" required asp-for="@Model.ProductLanguages[1].Category" placeholder="Kateqoriya daxil edin">
                        <span asp-validation-for="@Model.ProductLanguages[1].Category" class="text-danger"></span>
                    </div>


                </div>

                <hr />
                <br />
                <br />

                <div class="form-group">

                    <input asp-for="@Model.ProductLanguages[2].LanguageId" value="3" type="hidden" />
                    <div class="form-group">
                        <label for="exampleInputUsername1">Rusca ad</label>
                        <input class="form-control employeeName" required asp-for="@Model.ProductLanguages[2].Name" placeholder="Ad daxil edin">
                        <span asp-validation-for="@Model.ProductLanguages[2].Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="exampleInputUsername1">Rusca kateqoriya</label>
                        <input class="form-control employeePosition" required asp-for="@Model.ProductLanguages[2].Category" placeholder="Kateqoriya daxil edin">
                        <span asp-validation-for="@Model.ProductLanguages[2].Category" class="text-danger"></span>
                    </div>

                </div>

                <hr />
                <br />
                <br />



                <div class="form-group">
                    <label for="exampleInputUsername1"> Url əgər varsa:</label>
                    <input class="form-control" asp-for="Url" placeholder="Url daxil edin">
                    <span asp-validation-for="Url" class="text-danger"></span>
                </div>


                <div class="form-group">
                    <img src="@Model.ImagePath" />
                    <input type="hidden" asp-for="ImagePath" />
                    <label for="exampleInputUsername1"> Şəkil seçin</label>
                    <input class="form-control" asp-for="Image">
                    <span asp-validation-for="Image" class="text-danger"></span>
                </div>




                <button type="submit" class="btn btn-primary mr-2">Dəyişdir</button>
                <a class="btn btn-light" asp-action="Index">Ləğv et</a>
            </form>
        </div>
    </div>
</div>





@section Scripts {

    <script>



           const sameDataInput=document.querySelector(".sameDataInput")
           const nameInputs=document.querySelectorAll(".employeeName");
           const positionInputs=document.querySelectorAll(".employeePosition");

        sameDataInput.addEventListener("change",(e)=>{
            e.preventDefault();
            if(sameDataInput.checked){

                let name=nameInputs[0].value;
                let position=positionInputs[0].value;

                nameInputs.forEach(input=>input.value=name)
                positionInputs.forEach(input=>input.value=position)
            }
        })
    </script>
}
