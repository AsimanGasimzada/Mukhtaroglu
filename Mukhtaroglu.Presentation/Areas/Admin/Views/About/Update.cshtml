@model AboutUpdateDto

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <p class="card-description">
                Haqqımızda mətni dəyişdir
            </p>
            <form method="post" class="forms-sample" enctype="multipart/form-data">

                <div class="text-danger" asp-validation-summary="ModelOnly"></div>

                <div class="form-group">

                    <input asp-for="@Model.AboutLanguages[0].LanguageId" value="1" type="hidden" />
                    <div class="form-group">
                        <label for="exampleInputUsername1">Azərbaycanca başlıq</label>
                        <input class="form-control faqTopic" required asp-for="@Model.AboutLanguages[0].Title" placeholder="Başlıq daxil edin">
                        <span asp-validation-for="@Model.AboutLanguages[0].Title" class="text-danger"></span>
                    </div>



                    <div class="form-group">
                        <label for="exampleInputUsername1">Azərbaycanca açıqlama</label>
                        <textarea class="form-control rich-editor" id="description0" asp-for="@Model.AboutLanguages[0].Description" placeholder="Açıqlama daxil edin"></textarea>
                        <span asp-validation-for="@Model.AboutLanguages[0].Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input class=" sameDataInput" id="checkbox" type="checkbox">
                        <label for="checkbox">Bütün dillərdə eyni olsun</label>
                    </div>

                </div>

                <hr />
                <br />
                <br />

                <div class="form-group">

                    <input asp-for="@Model.AboutLanguages[1].LanguageId" value="2" type="hidden" />
                    <div class="form-group">
                        <label for="exampleInputUsername1">İngiliscə başlıq</label>
                        <input class="form-control faqTopic" required asp-for="@Model.AboutLanguages[1].Title" placeholder="Başlıq daxil edin">
                        <span asp-validation-for="@Model.AboutLanguages[1].Title" class="text-danger"></span>
                    </div>


                    <div class="form-group">
                        <label for="exampleInputUsername1">İngiliscə Açıqlama</label>
                        <textarea class="form-control rich-editor" id="description0" asp-for="@Model.AboutLanguages[1].Description" placeholder="Açıqlama daxil edin"></textarea>
                        <span asp-validation-for="@Model.AboutLanguages[1].Description" class="text-danger"></span>
                    </div>


                </div>

                <hr />
                <br />
                <br />
                <div class="form-group">

                    <input asp-for="@Model.AboutLanguages[2].LanguageId" value="3" type="hidden" />
                    <div class="form-group">
                        <label for="exampleInputUsername1">Rusca Başlıq</label>
                        <input class="form-control faqTopic" required asp-for="@Model.AboutLanguages[2].Title" placeholder="Başlıq daxil edin">
                        <span asp-validation-for="@Model.AboutLanguages[2].Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="exampleInputUsername1">Rusca açıqlama</label>
                        <textarea class="form-control rich-editor" id="description0" asp-for="@Model.AboutLanguages[2].Description" placeholder="Açıqlama daxil edin"></textarea>
                        <span asp-validation-for="@Model.AboutLanguages[2].Description" class="text-danger"></span>
                    </div>


                </div>

                <hr />
                <br />
                <br />


                <div class="form-group">
                    <label for="exampleInputUsername1"> Sıra nömrəsi daxil edin.Qeyd:Daxil etdiyiniz sıra nömrəsi bu mətnin səhifədə neçənci sırada olacağını göstərir</label>
                    <input class="form-control" asp-for="Order" placeholder="Sıra nömrəsi daxil edin">
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <img src="@Model.ImagePath" width="100" height="100" />
                    <input asp-for="ImagePath" type="hidden" />
                    <label for="exampleInputUsername1"> Şəkil daxil edin</label>
                    <input class="form-control" asp-for="Image">
                    <span asp-validation-for="Image" class="text-danger"></span>
                </div>




                <button type="submit" class="btn btn-warning mr-2">Dəyişdir</button>
                <a class="btn btn-light" asp-action="Index">Ləğv et</a>
            </form>
        </div>
    </div>
</div>





@section Scripts {

    <script>
           const sameDataInput=document.querySelector(".sameDataInput")
           const topicInputs=document.querySelectorAll(".faqTopic");

        sameDataInput.addEventListener("change",(e)=>{
            e.preventDefault();
            if(sameDataInput.checked){

                let topic=topicInputs[0].value;

                topicInputs.forEach(input=>input.value=topic)
            }
        })
    </script>
}
